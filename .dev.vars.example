# Load .env.development* files when running `wrangler dev`
NEXTJS_ENV=development

# better-auth
# openssl rand -base64 32 等で生成する
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# マジックリンク送信 (https://resend.com でアカウント・送信ドメインを用意する)
RESEND_API_KEY=
EMAIL_FROM=

# 書影補完 (https://console.cloud.google.com/apis/library/books.googleapis.com)
# 未設定でも動くが匿名クエリは共有クォータのため429になりやすい
GOOGLE_BOOKS_API_KEY=

# 映画・ドラマ検索 (https://www.themoviedb.org/settings/api でアカウント作成後、
# 「API 読み取りアクセストークン」ではなく「APIキー(v3 auth)」を取得する)
# 必須。未設定だと映画・ドラマの検索/追加は502を返す(NDL/MusicBrainz/iTunesと
# 異なり匿名利用不可)
TMDB_API_KEY=

# アニメ・マンガ検索 (https://myanimelist.net/apiconfig/create でアプリ登録し Client ID を取得する)
# Client Secretは不要(client_authのみで必要なエンドポイントは全て叩ける)
# 必須。未設定だとアニメ・マンガの検索/追加は502を返す
MAL_CLIENT_ID=
